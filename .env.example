# ==========================================================
# Crop Rescuer AI — Full-Stack Backend Environment Config
# ==========================================================

# 1. Supabase PostgreSQL Database & Auth (Required for Live DB)
# Replace with your Supabase Project URL & Anon Public Key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Google Gemini Multimodal Vision & Agronomist LLM (Optional for real API)
GEMINI_API_KEY=your-gemini-api-key-here

# 3. Server Configuration
PORT=3000
NODE_ENV=development